# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (multi-tenant)
DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agentdb

# Async workers
REDIS_URL=redis://localhost:6379/0

# LLM. Blank ANTHROPIC_API_KEY = offline deterministic regex extractor.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OCR. "pdftext" = native-PDF text, no system binary (offline-friendly).
# "tesseract" = real image OCR (needs the tesseract binary + pytesseract).
OCR_PROVIDER=pdftext

# ERP adapter (SAP OData shape). "mock" works offline; "sap_odata" posts to a
# real OData service at ERP_ODATA_BASE_URL (SAP gateway / Odoo bridge / mock).
ERP_PROVIDER=mock
ERP_ODATA_BASE_URL=
ERP_ODATA_TOKEN=

# Auth
JWT_SECRET=dev-only-change-me
